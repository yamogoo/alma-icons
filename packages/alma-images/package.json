{
  "name": "alma-images",
  "version": "0.0.1",
  "author": {
    "name": "yamogoo",
    "email": "grebennikovmisha@gmail.com",
    "fullName": "Mikhail Grebennikov",
    "url": "https://github.com/yamogoo"
  },
  "description": "Image Set with Multiple Weights & Appearances",
  "type": "module",
  "keywords": [
    "images",
    "svg",
    "illustrations",
    "alma"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/images": {
      "types": "./dist/react/images/index.d.ts",
      "import": "./dist/react/images/index.js"
    },
    "./react/images/*": {
      "types": "./dist/react/images/*.d.ts",
      "import": "./dist/react/images/*.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./vue/images": {
      "types": "./dist/vue/images/index.d.ts",
      "import": "./dist/vue/images/index.js"
    },
    "./vue/images/*": {
      "types": "./dist/vue/images/*.d.ts",
      "import": "./dist/vue/images/*.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    },
    "./images/svg": "./images",
    "./images/svg/*": "./images/*"
  },
  "files": [
    "images",
    "dist",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "ts-node --esm ./scripts/generate-manifest.ts",
    "validate": "node ./scripts/validate-generated.mjs",
    "build": "pnpm run generate && pnpm run validate",
    "prepack": "pnpm run build"
  },
  "packageManager": "pnpm@10.11.0",
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
